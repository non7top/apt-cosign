// Example apt-cosign policy. Copy to /etc/apt/apt.conf.d/99sigstore-policy
// and edit -- apt-cosign-method refuses every acquisition (fails closed)
// until a policy is configured.
//
// Choose ONE enforcement style below.

// Style 1: GitHub Actions workflow identity. Verifies the certificate was
// issued for a run of Owner/Name's Pipeline workflow, via GitHub Actions'
// fixed OIDC issuer. Owner/Name (together) and Pipeline/Ref are each
// optional -- see the commented-out fields below.
//
// Recommended practice: in repositories with multiple workflows (e.g. CI test
// runs or triage workflows granted id-token permissions), explicitly pin both
// Pipeline ("release.yml") and Ref ("refs/heads/main" or tags) to restrict
// signing trust strictly to authorized release workflows.
Acquire::sigstore::Enforce::Repo {
    Owner "your-org";
    Name "your-repo";
    Pipeline "release.yml";
    // Ref "refs/heads/main"; // recommended to pin: exact ref (or omit to match any ref via regex)

    // Owner/Name may both be left unset instead: they're then derived from
    // each request's own URL (github.com/raw.githubusercontent.com), so
    // this same block covers every GitHub-hosted source using the same
    // Pipeline convention, with no per-repo config.

    // Leaving Pipeline or Ref unset matches any workflow filename or ref via
    // regex (".+"). If a repo contains other workflows with OIDC signing
    // permissions, pin Pipeline and Ref explicitly above.
};

// Style 2: a raw OIDC issuer + certificate identity, matched exactly.
// Acquire::sigstore::Enforce::Fields {
//     certificate-oidc-issuer "https://accounts.google.com";
//     certificate-identity "you@example.com";
// };

// To trust more than one identity at once (e.g. two different repos signed
// by two different workflows), use named, URL-prefix-scoped blocks instead
// of the flat Enforce above. Match is checked as a prefix against the
// mapped https:// target (not the sigstore+https:// URI); the first
// matching Sources::<name> wins, in name order, falling back to Enforce
// above (if set) when nothing matches.
// Acquire::sigstore::Sources::apt-cosign {
//     Match "https://raw.githubusercontent.com/non7top/apt-cosign/";
//     Enforce::Repo { Owner "non7top"; Name "apt-cosign"; };
// };
// Acquire::sigstore::Sources::nginx-modules {
//     Match "https://raw.githubusercontent.com/non7top/nginx-modules/";
//     Enforce::Repo { Pipeline "build.yml"; };
// };

// Optional, any style:
// Acquire::sigstore::Enforce::Fields {
//     rekorLogIndex "100000"; // reject anything logged before this index
// };
// Acquire::sigstore::BundleExtension ".sigstore"; // sidecar file suffix
// Acquire::sigstore::GitHubToken "..."; // for the GitHub Attestations API fallback
// Acquire::sigstore::CacheDir "/var/lib/apt-cosign"; // TUF trusted-root cache
// Acquire::sigstore::Debug "true"; // enable diagnostic debug logging
// Acquire::sigstore::DebugLog "/var/lib/apt-cosign/debug.log"; // or "stderr"
